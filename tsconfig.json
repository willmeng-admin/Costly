{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/mobile/src/*"]
    }
  },
  "include": [
    "global.d.ts",
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "apps/mobile/nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile/node_modules"
  ]
}
